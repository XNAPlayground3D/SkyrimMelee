<Project>
  <Project.ExportOptions Namespace="SkyrimMelee.Ui" Class="HudPanel" />
  <Panel>
    <VerticalStackPanel Id="_renderStats" Left="24" Top="20"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Spacing="2" Padding="10" Background="#00000066">
      <Label Text="RENDER" TextColor="#8FA6C0" />
      <Label Id="_fps" Text="FPS  0.0" TextColor="#E6DCC8" />
      <Label Id="_drawCalls" Text="Draw calls  0" TextColor="#E6DCC8" />
      <Label Id="_primitives" Text="Primitives  0" TextColor="#E6DCC8" />
      <Label Id="_pause" Text="PAUSE  off" TextColor="#E6DCC8" />
      <Label Text="PLAYBACK" TextColor="#8FA6C0" />
      <Label Id="_clipName" Text="Clip  -" TextColor="#E6DCC8" />
      <Label Id="_clipSpeed" Text="Speed  1.00x" TextColor="#E6DCC8" />
      <Label Id="_clipProgress" Text="Progress  0ms/0ms" TextColor="#E6DCC8" />
    </VerticalStackPanel>

    <VerticalStackPanel Id="_vitals" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="24,0,0,24" Spacing="2" Padding="10" Background="#00000066">
      <Label Text="VITALS" TextColor="#8FA6C0" />
      <Label Id="_round" Text="ROUND 1  0 - 0" TextColor="#8FA6C0" />
      <Label Id="_healthText" Text="Health  150/150" TextColor="#E6DCC8" />
      <HorizontalProgressBar Id="_healthBar" Width="260" Height="14"
                             Minimum="0" Maximum="150" Value="150"
                             Filler="#B03A34" Background="#331A1A" />
      <Label Id="_staminaText" Text="Stamina  100/100" TextColor="#E6DCC8" />
      <HorizontalProgressBar Id="_staminaBar" Width="260" Height="10"
                             Minimum="0" Maximum="100" Value="100"
                             Filler="#6FA76F" Background="#1A2A1A" />
    </VerticalStackPanel>

    <VerticalStackPanel Id="_controls" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,20,24,0" Spacing="2" Padding="10" Background="#00000066">
      <Label Text="CONTROLS" TextColor="#8FA6C0" />
      <Label Text="amber = not yet implemented" TextColor="#7A7A86" />
      <Label Text="LMB or 1         Slash left" TextColor="#E6DCC8" />
      <Label Text="2                Slash right" TextColor="#E6DCC8" />
      <Label Text="Shift + LMB      Power slash" TextColor="#E6DCC8" />
      <Label Text="4                Stagger small" TextColor="#E6DCC8" />
      <Label Text="5                Stagger large" TextColor="#E6DCC8" />
      <Label Text="6                Death" TextColor="#E6DCC8" />
      <Label Text="7                Victory" TextColor="#E6DCC8" />
      <Label Text="8                Stagger micro" TextColor="#E6DCC8" />
      <Label Text="RMB (hold)       Block" TextColor="#E6DCC8" />
      <Label Text="F / LMB (block)  Bash" TextColor="#E6DCC8" />
      <Label Text="P                Pause sim (dev)" TextColor="#E6DCC8" />
      <Label Text="R                Reset idle (dev)" TextColor="#E6DCC8" />
      <Label Text="Z / X or - =     Sim speed (dev)" TextColor="#E6DCC8" />
      <Label Text="F1               Debug overlay" TextColor="#E6DCC8" />
      <Label Text="F2               Wireframe" TextColor="#E6DCC8" />
      <Label Text="Esc              Quit" TextColor="#E6DCC8" />
    </VerticalStackPanel>
  </Panel>
</Project>
