<Project>
  <Project.ExportOptions Namespace="SkyrimMelee.Ui" Class="HudPanel" />
  <Panel>
    <VerticalStackPanel Id="_playerHud" Left="24" Top="20"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Spacing="3">
      <Label Id="_playerName" Text="PLAYER" TextColor="#E6DCC8" />
      <Panel Width="420" Height="18">
        <HorizontalProgressBar Id="_playerHealthGhost" Width="420" Height="18"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Minimum="0" Maximum="150" Value="150"
                               Filler="#D8B878" Background="#331A1A" />
        <HorizontalProgressBar Id="_playerHealth" Width="420" Height="18"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Minimum="0" Maximum="150" Value="150"
                               Filler="#B03A34" Background="#00000000" />
      </Panel>
      <HorizontalProgressBar Id="_playerStamina" Width="340" Height="10"
                             Minimum="0" Maximum="100" Value="100"
                             Filler="#6FA76F" Background="#1A2A1A" />
    </VerticalStackPanel>

    <VerticalStackPanel Id="_opponentHud" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,20,24,0" Spacing="3">
      <Label Id="_opponentName" Text="DUELIST" TextColor="#E6DCC8"
             HorizontalAlignment="Right" />
      <Panel Width="420" Height="18">
        <HorizontalProgressBar Id="_opponentHealthGhost" Width="420" Height="18"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Minimum="0" Maximum="150" Value="150"
                               Filler="#D8B878" Background="#331A1A" />
        <HorizontalProgressBar Id="_opponentHealth" Width="420" Height="18"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Minimum="0" Maximum="150" Value="150"
                               Filler="#B03A34" Background="#00000000" />
      </Panel>
      <HorizontalProgressBar Id="_opponentStamina" Width="340" Height="10"
                             Minimum="0" Maximum="100" Value="100"
                             Filler="#6FA76F" Background="#1A2A1A"
                             HorizontalAlignment="Right" />
    </VerticalStackPanel>

    <HorizontalStackPanel Id="_roundPips" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Margin="0,18,0,0" Spacing="8">
      <Label Id="_playerPip0" Text="○" TextColor="#C6A260" />
      <Label Id="_playerPip1" Text="○" TextColor="#C6A260" />
      <Label Id="_roundLabel" Text="ROUND 1" TextColor="#8FA6C0" />
      <Label Id="_opponentPip0" Text="○" TextColor="#C4553F" />
      <Label Id="_opponentPip1" Text="○" TextColor="#C4553F" />
    </HorizontalStackPanel>

    <Label Id="_banner" HorizontalAlignment="Center" VerticalAlignment="Top"
           Margin="0,56,0,0" TextColor="#E6DCC8" Visible="False" />

    <VerticalStackPanel Id="_renderStats" Left="24" Top="20"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Spacing="2" Padding="10" Background="#00000066" Visible="False">
      <Label Text="RENDER" TextColor="#8FA6C0" />
      <Label Id="_fps" Text="FPS  0.0" TextColor="#E6DCC8" />
      <Label Id="_drawCalls" Text="Draw calls  0" TextColor="#E6DCC8" />
      <Label Id="_primitives" Text="Primitives  0" TextColor="#E6DCC8" />
      <Label Id="_pause" Text="PAUSE  off" TextColor="#E6DCC8" />
      <Label Text="PLAYBACK" TextColor="#8FA6C0" />
      <Label Id="_clipName" Text="Clip  -" TextColor="#E6DCC8" />
      <Label Id="_clipSpeed" Text="Speed  1.00x" TextColor="#E6DCC8" />
      <Label Id="_clipProgress" Text="Progress  0ms/0ms" TextColor="#E6DCC8" />
    </VerticalStackPanel>

    <VerticalStackPanel Id="_controls" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,20,24,0" Spacing="2" Padding="10" Background="#00000066" Visible="False">
      <Label Text="CONTROLS" TextColor="#8FA6C0" />
      <Label Text="amber = not yet implemented" TextColor="#7A7A86" />
      <Label Text="WASD             Move" TextColor="#E6DCC8" />
      <Label Text="Mouse            Look" TextColor="#E6DCC8" />
      <Label Text="Wheel            Zoom" TextColor="#E6DCC8" />
      <Label Text="F                First / third" TextColor="#E6DCC8" />
      <Label Text="LMB (tap)        Slash combo" TextColor="#E6DCC8" />
      <Label Text="Hold LMB         Power slash" TextColor="#E6DCC8" />
      <Label Text="1 / 2            Force left / right" TextColor="#E6DCC8" />
      <Label Text="4                Stagger small" TextColor="#E6DCC8" />
      <Label Text="5                Stagger large" TextColor="#E6DCC8" />
      <Label Text="6                Death" TextColor="#E6DCC8" />
      <Label Text="7                Victory" TextColor="#E6DCC8" />
      <Label Text="8                Stagger micro" TextColor="#E6DCC8" />
      <Label Text="RMB (hold)       Block" TextColor="#E6DCC8" />
      <Label Text="B / LMB (block)  Bash" TextColor="#E6DCC8" />
      <Label Text="P                Pause sim (dev)" TextColor="#E6DCC8" />
      <Label Text="R                Reset idle (dev)" TextColor="#E6DCC8" />
      <Label Text="Z / X or - =     Sim speed (dev)" TextColor="#E6DCC8" />
      <Label Text="F1               Debug overlay" TextColor="#E6DCC8" />
      <Label Text="F2               Wireframe" TextColor="#E6DCC8" />
      <Label Text="F3               Camera preset" TextColor="#E6DCC8" />
      <Label Text="[ ] / ;          Tune timing (debug)" TextColor="#E6DCC8" />
      <Label Text="Esc              Menu" TextColor="#E6DCC8" />
    </VerticalStackPanel>
  </Panel>
</Project>
